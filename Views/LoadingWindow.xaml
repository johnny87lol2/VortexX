<Window x:Class="VortexX.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VortexX" Width="420" Height="210"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        MouseLeftButtonDown="Window_Down">
    <Border x:Name="Root" CornerRadius="16" BorderThickness="1" Padding="28,24" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#000000" Opacity="0.55"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="LogoText" Text="VortexX" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="StatusText" FontSize="13" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
            <Border x:Name="Track" Height="6" CornerRadius="3" Margin="0,18,0,0" ClipToBounds="True">
                <Border x:Name="Bar" Width="120" Height="6" CornerRadius="3" HorizontalAlignment="Left">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="BarMove" X="0"/>
                    </Border.RenderTransform>
                </Border>
            </Border>
            <Button x:Name="BtnClose" Click="BtnClose_Click" HorizontalAlignment="Right" Margin="0,16,0,0"
                    Padding="14,6" BorderThickness="1" FontSize="12"/>
        </StackPanel>
    </Border>
</Window>
